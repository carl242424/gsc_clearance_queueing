---
const { href, label, icon, active = false } = Astro.props;
---
<a class:list={["admin-nav-link", { active }]} href={href} aria-current={active ? "page" : undefined}>
  <svg viewBox="0 0 20 20" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
    {icon === "overview" && <><rect x="2.75" y="2.75" width="5.75" height="5.75" rx=".75"/><rect x="11.5" y="2.75" width="5.75" height="5.75" rx=".75"/><rect x="2.75" y="11.5" width="5.75" height="5.75" rx=".75"/><rect x="11.5" y="11.5" width="5.75" height="5.75" rx=".75"/></>}
    {icon === "staff" && <><circle cx="7" cy="6.25" r="3"/><path d="M1.75 16.75c.4-2.8 2.4-4.25 5.25-4.25s4.85 1.45 5.25 4.25M14 4.25a3 3 0 0 1 0 5.75M14.5 12.5c2.1.35 3.25 1.75 3.75 4.25"/></>}
    {icon === "settings" && <><circle cx="10" cy="10" r="3"/><path d="m16.25 11.8 1.1.85-1.5 2.6-1.3-.5a7 7 0 0 1-1.65.95l-.2 1.4h-3l-.2-1.4a7 7 0 0 1-1.65-.95l-1.3.5-1.5-2.6 1.1-.85a7 7 0 0 1 0-1.9l-1.1-.85 1.5-2.6 1.3.5a7 7 0 0 1 1.65-.95l.2-1.4h3l.2 1.4a7 7 0 0 1 1.65.95l1.3-.5 1.5 2.6-1.1.85a7 7 0 0 1 0 1.9Z" transform="translate(-.5 -.5) scale(.95)"/></>}
    {icon === "history" && <><path d="M3 6.5V2.75M3 6.5h3.75"/><path d="M3.6 6.2A7 7 0 1 1 3 11M10 6v4l2.75 1.75"/></>}
    {icon === "qr" && <><rect x="2.5" y="2.5" width="5.5" height="5.5"/><rect x="12" y="2.5" width="5.5" height="5.5"/><rect x="2.5" y="12" width="5.5" height="5.5"/><path d="M12 12h2v2h-2zM16 12h1.5M16 15v2.5M12 16.5h2"/></>}
  </svg>
  <span>{label}</span>
</a>
