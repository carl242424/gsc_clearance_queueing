---
import BaseLayout from "../layouts/BaseLayout.astro";
---
<BaseLayout title="Team Sign In" page="login">
  <main class="auth-wrap">
    <section class="card auth-card">
      <img class="login-logo" src="https://scontent.fmnl9-1.fna.fbcdn.net/v/t39.30808-6/625540698_1363540042479394_8593338089776115193_n.jpg?stp=dst-jpg_tt6&cstp=mx2048x2030&ctp=s2048x2030&_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6ee11a&_nc_ohc=FE1CIOJwYVgQ7kNvwF1JHhz&_nc_oc=Adr0BSBfqLBMYYN4At78h1mBCLpWohpEbaRNZ4B2h28zE_tjg8Vvou1SaqpegxZDvy4O3AgEJW5Xx-Bm7tAuqPIp&_nc_zt=23&_nc_ht=scontent.fmnl9-1.fna&_nc_gid=GucpMbpJRfm6kquX0ybjSw&_nc_ss=7b3a8&oh=00_AQRGgDXegF8uPaOJAEe5XVXALH_M2yEvUn_Jd_D95k1cDA&oe=6B0DF02F" alt="Clearance Services logo" />
      <h1>Login</h1>
      <div id="login-alert" class="alert" role="alert"></div>
      <form id="login-form">
        <div class="field"><label for="identity">Username or email</label><input class="input" id="identity" name="identity" autocomplete="username" placeholder="Enter your username or email" required autofocus /></div>
        <div class="field"><label for="password">Password</label><input class="input" id="password" name="password" type="password" autocomplete="current-password" placeholder="Enter your password" required /></div>
        <button class="btn btn-primary login-button" type="submit">Sign in</button>
      </form>
    </section>
  </main>
</BaseLayout>
