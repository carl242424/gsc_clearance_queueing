---
import BaseLayout from "../layouts/BaseLayout.astro";
---
<BaseLayout title="Forgot password" page="forgot-password">
  <main class="auth-wrap">
    <section class="card auth-card">
      <h1>Forgot password?</h1>
      <p class="muted forgot-password-copy">We’ll email a six-digit reset code if an active account matches your email. The code expires in 10 minutes.</p>
      <div id="forgot-password-alert" class="alert" role="alert"></div>
      <form id="reset-request-form">
        <div class="field"><label for="reset-request-email">Email address</label><input class="input" id="reset-request-email" name="email" type="email" autocomplete="email" required /></div>
        <button class="btn btn-primary login-button" type="submit">Send reset code</button>
      </form>
      <form id="reset-password-form" hidden>
        <input id="reset-email" name="email" type="hidden" />
        <div class="field"><label for="reset-otp">Six-digit code</label><input class="input" id="reset-otp" name="otp" inputmode="numeric" autocomplete="one-time-code" pattern="[0-9]{6}" maxlength="6" required /></div>
        <div class="field"><label for="reset-new-password">New password</label><input class="input" id="reset-new-password" name="newPassword" type="password" minlength="12" autocomplete="new-password" required /></div>
        <div class="field"><label for="reset-confirm-password">Confirm new password</label><input class="input" id="reset-confirm-password" name="confirmPassword" type="password" minlength="12" autocomplete="new-password" required /></div>
        <button class="btn btn-primary login-button" type="submit">Reset password</button>
      </form>
      <a class="btn btn-secondary login-button" style="margin-top:12px" href="/">Back to sign in</a>
    </section>
  </main>
</BaseLayout>
