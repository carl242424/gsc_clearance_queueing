---
import BaseLayout from "../layouts/BaseLayout.astro";
---
<BaseLayout title="Forgot password" page="forgot-password">
  <main class="auth-wrap">
    <section class="card auth-card">
      <h1>Forgot password?</h1>
      <p class="muted forgot-password-copy">Ask your system administrator to issue you a temporary password from Staff Accounts. You’ll be asked to choose a new password the next time you sign in. If you are the administrator, contact the person who manages this deployment.</p>
      <a class="btn btn-primary login-button" href="/">Back to sign in</a>
    </section>
  </main>
</BaseLayout>
