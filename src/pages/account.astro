---
import BaseLayout from "../layouts/BaseLayout.astro";
---
<BaseLayout title="Account settings" page="account">
  <main class="auth-wrap">
    <section class="card auth-card">
      <a class="forgot-password-link" id="account-back-link">Back to dashboard</a>
      <h1>Account settings</h1>
      <p class="muted" id="account-name"></p>
      <div class="account-progress">
        <div class="account-progress-track" role="progressbar" aria-label="Account settings progress" aria-valuemin="1" aria-valuemax="2" aria-valuenow="1"><span id="account-progress-fill"></span></div>
        <p class="muted" id="account-step-label">Step 1 of 2 · Update email</p>
      </div>
      <section id="account-email-step">
        <h2 class="section-title">Update email</h2>
        <div id="account-email-alert" class="alert" role="alert"></div>
        <form id="account-email-form">
          <div class="field"><label for="account-email">Email address</label><input class="input" id="account-email" name="email" type="email" autocomplete="email" required /></div>
          <div class="field" id="email-current-password-field" hidden><label for="email-current-password">Current password</label><input class="input" id="email-current-password" name="currentPassword" type="password" autocomplete="current-password" /></div>
          <div class="account-step-actions">
            <button class="btn btn-secondary" id="account-email-next" type="button">Next</button>
            <button class="btn btn-primary" id="account-email-submit" type="submit" hidden>Update email &amp; Next</button>
          </div>
        </form>
      </section>
      <section id="account-password-step" hidden>
        <h2 class="section-title">Update password</h2>
        <p class="muted">Leave these fields blank to finish without changing your password.</p>
        <div id="account-password-alert" class="alert" role="alert"></div>
        <form id="account-password-form">
          <div class="field"><label for="password-current">Current password</label><div class="password-control"><input class="input" id="password-current" name="currentPassword" type="password" autocomplete="current-password" /><button class="password-toggle" type="button" data-password-toggle="password-current" aria-controls="password-current" aria-pressed="false">Show</button></div></div>
          <div class="field"><label for="password-new">New password</label><div class="password-control"><input class="input" id="password-new" name="newPassword" type="password" minlength="12" autocomplete="new-password" /><button class="password-toggle" type="button" data-password-toggle="password-new" aria-controls="password-new" aria-pressed="false">Show</button></div></div>
          <div class="field"><label for="password-confirm">Confirm new password</label><div class="password-control"><input class="input" id="password-confirm" name="confirmPassword" type="password" minlength="12" autocomplete="new-password" /><button class="password-toggle" type="button" data-password-toggle="password-confirm" aria-controls="password-confirm" aria-pressed="false">Show</button></div></div>
          <div class="account-step-actions">
            <button class="btn btn-secondary" id="account-password-back" type="button">Back</button>
            <button class="btn btn-secondary" id="account-password-finish" type="button">Finish without changing</button>
            <button class="btn btn-primary" id="account-password-submit" type="submit" hidden>Update password &amp; Finish</button>
          </div>
        </form>
      </section>
    </section>
  </main>
</BaseLayout>
