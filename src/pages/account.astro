---
import BaseLayout from "../layouts/BaseLayout.astro";
---
<BaseLayout title="Account settings" page="account">
  <main class="auth-wrap">
    <section class="card auth-card">
      <a class="forgot-password-link" id="account-back-link">Back to dashboard</a>
      <h1>Account settings</h1>
      <p class="muted" id="account-name"></p>
      <h2 class="section-title" style="margin-top:24px">Update email</h2>
      <div id="account-email-alert" class="alert" role="alert"></div>
      <form id="account-email-form">
        <div class="field"><label for="account-email">Email address</label><input class="input" id="account-email" name="email" type="email" autocomplete="email" required /></div>
        <div class="field"><label for="email-current-password">Current password</label><input class="input" id="email-current-password" name="currentPassword" type="password" autocomplete="current-password" required /></div>
        <button class="btn btn-primary login-button" type="submit">Update email</button>
      </form>
      <h2 class="section-title" style="margin-top:30px">Update password</h2>
      <div id="account-password-alert" class="alert" role="alert"></div>
      <form id="account-password-form">
        <div class="field"><label for="password-current">Current password</label><input class="input" id="password-current" name="currentPassword" type="password" autocomplete="current-password" required /></div>
        <div class="field"><label for="password-new">New password</label><input class="input" id="password-new" name="newPassword" type="password" minlength="12" autocomplete="new-password" required /></div>
        <div class="field"><label for="password-confirm">Confirm new password</label><input class="input" id="password-confirm" name="confirmPassword" type="password" minlength="12" autocomplete="new-password" required /></div>
        <button class="btn btn-primary login-button" type="submit">Update password</button>
      </form>
    </section>
  </main>
</BaseLayout>
